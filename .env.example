# TYPESAFE_API_KEY=your-key-here
# Optional: point at a self-hosted/gateway TypeSafe-compatible API
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Optional: model ID (default: jev-latest)
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional real generator. Supply an application API endpoint/model and
# provider API key; a chat-product subscription is not assumed to include API access.
# JEVLOOP_GENERATOR_MODE=openai-compatible
# JEVLOOP_GENERATOR_BASE_URL=https://api.example.com/v1
# JEVLOOP_GENERATOR_MODEL=your-model-name
# JEVLOOP_GENERATOR_API_KEY=
